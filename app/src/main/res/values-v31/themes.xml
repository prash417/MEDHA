<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Medha.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_ink</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_blank</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/splash_ink</item>
        <item name="postSplashScreenTheme">@style/Theme.Medha</item>
        <item name="android:windowSplashScreenBackground">@color/splash_ink</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_blank</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/splash_ink</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
        <item name="android:windowBackground">@color/splash_ink</item>
        <item name="android:statusBarColor">@color/splash_ink</item>
        <item name="android:navigationBarColor">@color/splash_ink</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
