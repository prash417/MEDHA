rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Each player's own profile copy (written by the app).
    match /players/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.uid == uid;
      allow delete: if false;
    }

    // Public leaderboard. Anyone signed in can read; a player can only write their own row,
    // with only these fields and sane values.
    match /leaderboard/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(
          ['uid', 'displayName', 'avatarId', 'xp', 'level', 'bestPrize', 'correctAnswers', 'wins', 'updatedAt'])
        && request.resource.data.uid == uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 16
        && request.resource.data.xp is int
        && request.resource.data.xp >= 0
        && request.resource.data.bestPrize is int
        && request.resource.data.bestPrize >= 0
        && request.resource.data.bestPrize <= 10000000;
      allow delete: if false;
    }

    match /questions/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /categories/{id} {
      allow read: if true;
      allow write: if false;
    }
  }
}
